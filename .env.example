# Local server
PORT=3000
BASE_URL=http://localhost:3000

# Admin API — generate a long random value for each environment
ADMIN_SECRET=replace_with_long_random_value

# Stripe — use dashboard-managed values; never commit real keys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Shop notifications
SHOP_OWNER_EMAIL=owner@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=shop@example.com
